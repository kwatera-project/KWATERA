POSTGRES_DB=YOUR_DATABASE_NAME_HERE
POSTGRES_PASSWORD=YOUR_PASSWORD_HERE
POSTGRES_USER=YOUR_USERNAME_HERE
JWT_SECRET=YOUR_JWT_SECRET_HERE
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY_HERE
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET_HERE
STRIPE_PUBLISHABLE_KEY=YOUR_STRIPE_PUBLISHABLE_KEY_HERE
SPRING_AI_OPENAI_API_KEY=YOUR_GROQ_API_KEY_HERE

# Generate a private random token with at least 32 characters; share only with backend callers.
KWATERA_INTERNAL_TOKEN=
AI_SERVICE_PORT=8088
# Independent summary/detection and translation models. Legacy OLLAMA_MODEL only affects summaries.
OLLAMA_SUMMARY_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_TRANSLATION_MODEL=translategemma:4b
# Use JSON with an instruction model; TRANSLATE_GEMMA requires the dedicated text prompt.
AI_TRANSLATION_FORMAT=TRANSLATE_GEMMA
AI_REQUEST_TIMEOUT=120s
AI_TEMPERATURE=0.1
AI_MAX_OUTPUT_TOKENS=1024
